# Repositorio que hace de base de datos (conviene PRIVADO: ahi quedan los proyectos de los usuarios)
GIT_REPO_URL=https://github.com/USUARIO/syntotec-data.git
GIT_BRANCH=main
# Token con permiso de escritura SOLO sobre ese repositorio (fine-grained: Contents read/write).
# Vive unicamente en el servidor: nunca llega al navegador, ni a los logs, ni a la configuracion de git.
GIT_TOKEN=
GIT_AUTHOR_NAME=Syntotec
GIT_AUTHOR_EMAIL=syntotec@localhost
# Cada cuanto se versiona lo que cambio (ms) y cada cuanto se traen cambios hechos a mano en el repo (0 = nunca)
COMMIT_DELAY_MS=5000
PULL_INTERVAL_MS=0
