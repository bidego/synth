{
  "name": "syntotec-desktop",
  "productName": "Syntotec",
  "version": "0.7.35",
  "description": "Syntotec Synth Studio para escritorio (macOS)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "node scripts/copy-web.js",
    "test": "node test/lib.test.js",
    "dist:mac": "npm run web && electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zondacloud.syntotec",
    "productName": "Syntotec",
    "copyright": "Syntotec",
    "files": ["main.js", "lib.js", "preload.js", "app/**/*", "package.json"],
    "directories": { "output": "dist" },
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Syntotec usa la entrada de audio de tu placa de sonido para grabar instrumentos y voces."
      }
    },
    "dmg": { "title": "Syntotec ${version}" }
  }
}
